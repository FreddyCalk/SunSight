# Root local environment for Supabase CLI config.toml env() substitution.
# The Supabase CLI reads a .env file at the repository root (next to this
# file and the supabase/ directory) when resolving env(...) values in
# supabase/config.toml. Copy this file before starting the local stack:
#
#   cp .env.example .env
#   npx supabase start
#
# `.env` is gitignored. Never commit filled values and never place real
# secrets in this example. The placeholders below only satisfy local config
# parsing; they are not usable Twilio credentials. Local OTP uses the
# committed auth.sms.test_otp mapping (+12025550100 -> 123456), not Twilio.
#
# Replace with a real Account SID (AC...), Auth Token, and Verify Service SID
# (VA...) only in an ignored .env for live local SMS, never here.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=local-placeholder
SUPABASE_AUTH_SMS_TWILIO_VERIFY_SERVICE_SID=VA00000000000000000000000000000000
